<?xml version="1.0"?>
<Plugin>
	<Information>
		<Name>StatsExporter</Name>
		<Author>DarkLink</Author>
		<Version>0.0.10</Version>
		<Description>
			Exports character stats and item data via Turbine.PluginData.
		</Description>
    <Image>StatsExporter/resources/Ring.tga</Image>
	</Information>
